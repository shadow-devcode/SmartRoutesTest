# Plantilla del .env. Copiar a .env y ajustar valores reales.
# El archivo .env real está en .gitignore y NUNCA debe subirse al repo.
# IMPORTANTE: este archivo SÍ se versiona → usar SOLO placeholders, nunca
# secretos reales (claves, tokens, contraseñas).

# --- Entorno -----------------------------------------------------------
# "production" activa validaciones estrictas (secreto JWT obligatorio y fuerte,
# sin fail-open de auth). Cualquier otro valor = desarrollo.
APP_ENV=development

# Permite servir la API SIN auth si el bootstrap de auth falla. SOLO desarrollo.
# Debe ser false (o ausente) en producción.
ALLOW_INSECURE_NO_AUTH=false

# --- Servidor de desarrollo (solo `python app.py`) ---------------------
# En producción usar gunicorn (NO el servidor de Flask). debug=true habilita el
# debugger de Werkzeug (riesgo de RCE) → jamás en producción.
FLASK_DEBUG=false
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# --- Base de datos MySQL / MariaDB -------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=cambia_esto
DB_PASSWORD=cambia_esto
DB_NAME=smartroutes_auth

# --- JWT ---------------------------------------------------------------
# OBLIGATORIO en producción: >=32 chars aleatorios. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=GENERA_UN_SECRETO_UNICO_NO_USES_ESTE
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- Fuerza bruta ------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Umbral por IP (más alto por NAT). 0 = desactivado.
MAX_LOGIN_ATTEMPTS_PER_IP=20

# --- Proxy / reverse-proxy ---------------------------------------------
# Activar SOLO si la app corre detrás de un proxy de confianza (nginx, PaaS)
# que fija X-Forwarded-For. Si es false se usa la IP real del socket.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1

# --- Subidas -----------------------------------------------------------
# Tamaño máximo del Excel subido (MB).
MAX_UPLOAD_MB=25

# --- CORS / Cookies ----------------------------------------------------
# Desarrollo: dominio(s) reales del frontend, separados por coma.
CORS_ORIGINS=http://localhost:4200
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
#
# 🌐 PRODUCCIÓN — cuando tengas el dominio, sustituye las 3 líneas de arriba por:
#   CORS_ORIGINS=https://TU-DOMINIO.com
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=Lax   (usa Strict si front y API están en el mismo dominio)
# Usa https:// y sin barra final; separa varios orígenes por coma si hace
# falta (p.ej. https://TU-DOMINIO.com,https://app.TU-DOMINIO.com).

# --- Mapbox ------------------------------------------------------------
# Token para Directions API + geocoding inverso.
# Crear en https://account.mapbox.com/access-tokens/ con scopes:
#   - directions:read
#   - geocoding:read
# Restringe el token por URL al dominio de producción.
MAPBOX_ACCESS_TOKEN=pk.TU_TOKEN_DE_MAPBOX
